# 数据库连接（开发环境使用 SQLite）
DATABASE_URL="file:./dev.db"

# 生产环境数据库连接（PostgreSQL）
# DATABASE_URL="postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres"

# JWT 密钥（生产环境必须设置）
JWT_SECRET="your-random-secret-key-here"

# 管理员邮箱列表（逗号分隔）
ADMIN_EMAILS="admin@example.com"

# 支付功能开关（默认关闭，设为 true 启用）
PAYMENT_ENABLED="false"
NEXT_PUBLIC_PAYMENT_ENABLED="false"

# 应用地址（启用支付时用于微信回调）
APP_URL="https://your-domain.com"

# 支付模式：mock（开发模拟）| wechat（真实微信支付）
# PAYMENT_MODE="mock"

# 微信支付（Native 扫码支付）
# 商户平台 https://pay.weixin.qq.com 获取以下配置
WECHAT_APP_ID="wx_xxxxxxxx"
WECHAT_MCH_ID="1234567890"
WECHAT_API_V3_KEY="your-32-char-api-v3-key"
WECHAT_SERIAL_NO="商户API证书序列号"
# PEM 内容，换行用 \n 表示
WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WECHAT_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# OpenAI 兼容接口配置
OPENAI_API_KEY="your_api_key_here"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
