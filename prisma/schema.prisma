generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum ProcessingStatus {
  PENDING
  DONE
  FAILED
}

enum AnalysisStatus {
  NOT_STARTED
  RUNNING
  DONE
  FAILED
}

enum MessageRole {
  user
  assistant
}

model User {
  id           String     @id @default(cuid())
  email       String     @unique
  passwordHash String
  nickname    String?
  isAdmin     Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  characters Character[]
  sessions   Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Character {
  id             String           @id @default(cuid())
  userId         String?
  nickname      String
  relationship  String?
  background    String?
  timeframe     String?
  impression    String?
  avatarUrl      String?
  userAvatarUrl  String?
  parseStatus    ProcessingStatus @default(PENDING)
  analysisStatus AnalysisStatus   @default(NOT_STARTED)
  errorMessage  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user             User?             @relation(fields: [userId], references: [id])
  sourceDocuments SourceDocument[]
  analysis        Analysis?
  chatMessages    ChatMessage[]
}

model SourceDocument {
  id         String   @id @default(cuid())
  characterId String
  filename   String
  fileType   String
  content    String
  createdAt  DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Analysis {
  id                  String   @id @default(cuid())
  characterId         String   @unique
  persona             Json
  memories            Json
  speakingStyle       Json
  emotionPattern      Json
  relationshipPattern Json
  rawResponse         String
  modelName           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String      @id @default(cuid())
  characterId String
  role        MessageRole
  content     String
  createdAt   DateTime    @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}
